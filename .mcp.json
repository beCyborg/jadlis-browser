{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@0.0.78",
        "--extension",
        "--snapshot-mode=none",
        "--console-level=error",
        "--image-responses=omit"
      ],
      "env": {
        "PLAYWRIGHT_MCP_EXTENSION_TOKEN": "${user_config.PLAYWRIGHT_MCP_EXTENSION_TOKEN}"
      }
    }
  }
}
